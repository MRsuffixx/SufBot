{
  "name": "@sufbot/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "node ../../infrastructure/scripts/run-source-app.mjs src/index.ts",
