    "@fastify/swagger-ui": "6.1.0",
    "@sufbot/auth": "workspace:*",
    "@sufbot/billing": "workspace:*",
    "@sufbot/cache": "workspace:*",
    "@sufbot/config": "workspace:*",
    "@sufbot/database": "workspace:*",
    "@sufbot/discord": "workspace:*",
    "@sufbot/logger": "workspace:*",
    "@sufbot/onboarding": "workspace:*",
    "@sufbot/queue": "workspace:*",
    "@sufbot/shared": "workspace:*",
    "fastify": "5.10.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@sufbot/typescript-config": "workspace:*",
    "tsx": "4.23.1",
    "typescript": "7.0.2"
