# Runtime selector (the only non-secret operational value in this file).
NODE_ENV=development

# Local Docker service credentials. Replace these development-only examples.
POSTGRES_USER=sufbot
POSTGRES_PASSWORD=sufbot_local_password
POSTGRES_DB=sufbot
POSTGRES_PORT=5432
REDIS_PASSWORD=sufbot_local_password
REDIS_PORT=6379

# Host commands use loopback. Containers use Docker service DNS names.
DATABASE_URL=postgresql://sufbot:sufbot_local_password@127.0.0.1:5432/sufbot?schema=public
DIRECT_DATABASE_URL=postgresql://sufbot:sufbot_local_password@127.0.0.1:5432/sufbot?schema=public
DATABASE_URL_DOCKER=postgresql://sufbot:sufbot_local_password@postgres:5432/sufbot?schema=public
DIRECT_DATABASE_URL_DOCKER=postgresql://sufbot:sufbot_local_password@postgres:5432/sufbot?schema=public
TEST_DATABASE_URL=postgresql://sufbot:sufbot_test_password@localhost:5433/sufbot_test
REDIS_URL=redis://:sufbot_local_password@127.0.0.1:6379/0
REDIS_URL_DOCKER=redis://:sufbot_local_password@redis:6379/0

# Discord application credentials.
DISCORD_BOT_TOKEN=
# Canonical Discord application ID. During migration, DISCORD_CLIENT_ID must match it.
DISCORD_APPLICATION_ID=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_PUBLIC_KEY=
# Comma-separated guild IDs for immediate development command deployment.
DISCORD_DEVELOPMENT_GUILD_IDS=

# Auth.js and cryptographic material.
# Generate AUTH_SECRET and service secrets with: openssl rand -base64 48
# ENCRYPTION_KEY and SESSION_ENCRYPTION_KEY must decode to exactly 32 bytes:
# openssl rand -base64 32
AUTH_SECRET=
AUTH_TRUST_HOST=true
INTERNAL_API_SECRET=
WEBHOOK_SIGNING_SECRET=
ENCRYPTION_KEY=
SESSION_ENCRYPTION_KEY=

# Billing provider credentials. Billing remains unavailable until config.json enables a provider
# and the corresponding readiness check succeeds. Never prefix these values with NEXT_PUBLIC_.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
PAYTR_CALLBACK_URL=
PAYTR_RECURRING_ENABLED=false
PAYTR_CARD_STORAGE_ENABLED=false

# Independent billing service signing and token-encryption material.
BILLING_INTERNAL_SIGNING_SECRET=
BILLING_ENCRYPTION_KEY=

# Immutable Discord snowflake allowlists (comma separated).
BOT_OWNER_DISCORD_IDS=
BOT_DEVELOPER_DISCORD_IDS=
PLATFORM_ADMIN_DISCORD_IDS=

# Optional error reporting endpoint; may contain a private project key.
SENTRY_DSN=
