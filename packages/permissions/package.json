{
  "name": "@sufbot/permissions",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "sufbot-source": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --sourcemap",
    "dev:build": "tsup src/index.ts --format esm --sourcemap",
    "dev": "tsup src/index.ts --format esm --watch --sourcemap",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@sufbot/shared": "workspace:*"
  },
  "devDependencies": {
    "@sufbot/typescript-config": "workspace:*",
    "tsup": "8.5.1",
    "typescript": "7.0.2"
  }
}
