{
  "name": "@sufbot/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./generated": {
      "types": "./src/generated/prisma/client.ts",
      "default": "./dist/generated.js"
    }
  },
  "scripts": {
    "generate": "prisma generate --config prisma.config.ts",
    "validate": "prisma validate --config prisma.config.ts",
    "migrate": "prisma migrate dev --config prisma.config.ts",
    "migrate:deploy": "prisma migrate deploy --config prisma.config.ts",
    "migrate:reset": "prisma migrate reset --config prisma.config.ts",
    "seed": "prisma db seed --config prisma.config.ts",
    "studio": "prisma studio --config prisma.config.ts",
    "build": "pnpm generate && tsup src/index.ts src/generated.ts --format esm --dts --clean --sourcemap",
    "dev": "tsup src/index.ts src/generated.ts --format esm --dts --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.9.0",
    "@prisma/client": "7.9.0",
    "@sufbot/shared": "workspace:*",
    "pg": "8.22.0"
  },
  "devDependencies": {
    "@prisma/config": "7.9.0",
    "@sufbot/typescript-config": "workspace:*",
    "@types/pg": "8.20.0",
    "dotenv": "17.4.2",
    "prisma": "7.9.0",
    "tsx": "4.23.1",
    "tsup": "8.5.1",
    "typescript": "6.0.3"
  }
}
