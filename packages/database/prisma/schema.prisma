generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum PlatformRole {
  USER
  ADMIN
  DEVELOPER
  OWNER
}

enum AuditOutcome {
  SUCCESS
  FAILURE
}

enum CommandSubjectType {
  EVERYONE
  USER
  ROLE
  CHANNEL
}

enum ApiKeyStatus {
  ACTIVE
  REVOKED
}

enum BillingProviderName {
  STRIPE
  PAYTR
}

enum BillingInterval {
  MONTH
}

enum BillingCustomerStatus {
  ACTIVE
  DISABLED
}

enum GuildSubscriptionStatus {
  PENDING
  INCOMPLETE
  ACTIVE
  PAST_DUE
  GRACE_PERIOD
  SUSPENDED
  CANCELLED
  EXPIRED
  DISPUTED
  REFUNDED
}

enum CancellationStatus {
  NONE
  SCHEDULED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
  DISPUTED
  REVERSED
  UNKNOWN
}

enum PaymentTransactionType {
  INITIAL
  RENEWAL
  RETRY
  REFUND
  PARTIAL_REFUND
  CHARGEBACK
  REVERSAL
}

enum BillingProviderEventStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
  IGNORED
  DEAD_LETTERED
}

enum CheckoutSessionState {
  CREATED
  PROVIDER_PENDING
  COMPLETED
  EXPIRED
  CANCELLED
  FAILED
}

enum GuildEntitlementStatus {
  ACTIVE
  REVOKED
  EXPIRED
  SUSPENDED
}

enum GuildEntitlementSource {
  SUBSCRIPTION
  MANUAL_PROMOTION
  ADMIN_OVERRIDE
}

enum BillingAuditActorType {
  USER
  SYSTEM
  WORKER
  PROVIDER
  STAFF
}

enum BackgroundJobStatus {
  QUEUED
  ACTIVE
  COMPLETED
  FAILED
  DEAD_LETTERED
}

model User {
  id             String       @id @default(uuid()) @db.Uuid
  discordId      String       @unique @db.VarChar(20)
  displayName    String       @db.VarChar(100)
  avatarHash     String?      @db.VarChar(128)
  platformRole   PlatformRole @default(USER)
  sessionVersion Int          @default(1)
  lastLoginAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  oauthCredential          OAuthCredential?
  sessions                 AuthSession[]
  guildAccessGrants        GuildAccessGrant[]
  auditActions             GuildAuditLog[]       @relation("AuditActor")
  dashboardAccessLogs      DashboardAccessLog[]
  apiKeys                  ApiKey[]
  commandUsages            CommandUsage[]
  billingCustomers         BillingCustomer[]
  purchasedSubscriptions   GuildSubscription[]   @relation("SubscriptionPurchaser")
  paymentTransactions      PaymentTransaction[]
  checkoutSessions         CheckoutSession[]
  billingAuditEvents       BillingAuditEvent[]   @relation("BillingAuditActor")
  billingNotifications     BillingNotification[]
  billingRiskBlocksCreated BillingRiskBlock[]    @relation("BillingRiskBlockCreatedBy")
  billingRiskBlocksRevoked BillingRiskBlock[]    @relation("BillingRiskBlockRevokedBy")

  @@index([platformRole])
  @@index([deletedAt])
}

model OAuthCredential {
  userId                 String   @id @db.Uuid
  provider               String   @default("discord") @db.VarChar(32)
  accessTokenCiphertext  String   @db.Text
  refreshTokenCiphertext String?  @db.Text
  expiresAt              DateTime
  tokenType              String?  @db.VarChar(32)
  scope                  String?  @db.VarChar(255)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuthSession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique @db.Char(64)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([revokedAt])
}

model Guild {
  id                           String    @id @db.VarChar(20)
  name                         String    @db.VarChar(100)
  iconHash                     String?   @db.VarChar(128)
  ownerDiscordId               String    @db.VarChar(20)
  botInstalled                 Boolean   @default(true)
  botUserId                    String?   @db.VarChar(20)
  botPermissionBitfield        String?   @db.VarChar(32)
  botHasAdministrator          Boolean?
  botHighestRolePosition       Int?
  botStatusUpdatedAt           DateTime?
  botLastSeenAt                DateTime?
  commandRegistrationMode      String?   @db.VarChar(32)
  commandRegistrationStatus    String?   @db.VarChar(32)
  registeredCommandCount       Int?
  commandSchemaHash            String?   @db.Char(64)
  commandRegistrationUpdatedAt DateTime?
  billingEntitlementVersion    Int       @default(1)
  joinedAt                     DateTime  @default(now())
  leftAt                       DateTime?
  createdAt                    DateTime  @default(now())
  updatedAt                    DateTime  @updatedAt

  settings             GuildSettings?
  modules              GuildModule[]
  rolePermissions      GuildRolePermission[]
  commandOverrides     GuildCommandOverride[]
  auditLogs            GuildAuditLog[]
  accessGrants         GuildAccessGrant[]
  dashboardAccessLogs  DashboardAccessLog[]
  commandUsages        CommandUsage[]
  apiKeys              ApiKey[]
  subscriptions        GuildSubscription[]
  featureFlags         FeatureFlag[]
  entitlements         GuildEntitlement[]
  paymentTransactions  PaymentTransaction[]
  checkoutSessions     CheckoutSession[]
  billingAuditEvents   BillingAuditEvent[]
  billingNotifications BillingNotification[]

  @@index([ownerDiscordId])
  @@index([botInstalled, leftAt])
  @@index([botUserId, botLastSeenAt])
}

model GuildSettings {
  guildId       String   @id @db.VarChar(20)
  locale        String   @default("en") @db.VarChar(5)
  timezone      String   @default("UTC") @db.VarChar(64)
  commandPrefix String   @default("!") @db.VarChar(5)
  version       Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
}

model GuildModule {
  id        String   @id @default(uuid()) @db.Uuid
  guildId   String   @db.VarChar(20)
  moduleKey String   @db.VarChar(64)
  enabled   Boolean  @default(false)
  config    Json     @default("{}")
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, moduleKey])
  @@index([guildId, enabled])
}

model GuildRolePermission {
  id            String   @id @default(uuid()) @db.Uuid
  guildId       String   @db.VarChar(20)
  discordRoleId String   @db.VarChar(20)
  permissions   String[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, discordRoleId])
  @@index([guildId])
}

model GuildCommandOverride {
  id          String             @id @default(uuid()) @db.Uuid
  guildId     String             @db.VarChar(20)
  commandName String             @db.VarChar(64)
  subjectType CommandSubjectType
  subjectId   String             @db.VarChar(32)
  allow       String[]
  deny        String[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, commandName, subjectType, subjectId])
  @@index([guildId, commandName])
}

model GuildAuditLog {
  id             String       @id @default(uuid()) @db.Uuid
  guildId        String?      @db.VarChar(20)
  actorUserId    String?      @db.Uuid
  actorDiscordId String?      @db.VarChar(20)
  action         String       @db.VarChar(100)
  resourceType   String       @db.VarChar(64)
  resourceId     String?      @db.VarChar(128)
  previousValue  Json?
  newValue       Json?
  ipAddressHash  String?      @db.Char(64)
  userAgent      String?      @db.VarChar(255)
  requestId      String       @db.VarChar(128)
  outcome        AuditOutcome
  failureReason  String?      @db.VarChar(255)
  metadata       Json         @default("{}")
  createdAt      DateTime     @default(now())

  guild Guild? @relation(fields: [guildId], references: [id], onDelete: SetNull)
  actor User?  @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([guildId, createdAt(sort: Desc)])
  @@index([actorUserId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@index([requestId])
}

model GuildAccessGrant {
  id                 String   @id @default(uuid()) @db.Uuid
  userId             String   @db.Uuid
  guildId            String   @db.VarChar(20)
  isOwner            Boolean  @default(false)
  permissionBitfield String   @db.VarChar(32)
  source             String   @default("discord_oauth") @db.VarChar(32)
  verifiedAt         DateTime
  expiresAt          DateTime
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([userId, guildId])
  @@index([guildId, expiresAt])
  @@index([userId, expiresAt])
}

model DashboardAccessLog {
  id            String       @id @default(uuid()) @db.Uuid
  userId        String       @db.Uuid
  guildId       String?      @db.VarChar(20)
  route         String       @db.VarChar(255)
  requestId     String       @db.VarChar(128)
  outcome       AuditOutcome
  failureReason String?      @db.VarChar(255)
  ipAddressHash String?      @db.Char(64)
  userAgent     String?      @db.VarChar(255)
  createdAt     DateTime     @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  guild Guild? @relation(fields: [guildId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
  @@index([guildId, createdAt(sort: Desc)])
}

model CommandUsage {
  id            String   @id @default(uuid()) @db.Uuid
  guildId       String?  @db.VarChar(20)
  userId        String?  @db.Uuid
  discordUserId String   @db.VarChar(20)
  commandName   String   @db.VarChar(64)
  correlationId String   @db.VarChar(128)
  success       Boolean
  durationMs    Int
  errorCode     String?  @db.VarChar(64)
  shardId       Int?
  createdAt     DateTime @default(now())

  guild Guild? @relation(fields: [guildId], references: [id], onDelete: SetNull)
  user  User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([guildId, commandName, createdAt(sort: Desc)])
  @@index([discordUserId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
}

model ApiKey {
  id         String       @id @default(uuid()) @db.Uuid
  userId     String       @db.Uuid
  guildId    String?      @db.VarChar(20)
  name       String       @db.VarChar(100)
  keyPrefix  String       @db.VarChar(16)
  keyHash    String       @unique @db.Char(64)
  scopes     String[]
  status     ApiKeyStatus @default(ACTIVE)
  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  guild Guild? @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([guildId, status])
}

model BillingPlan {
  id                String          @id @default(uuid()) @db.Uuid
  code              String          @unique @db.VarChar(64)
  displayName       String          @db.VarChar(100)
  active            Boolean         @default(true)
  interval          BillingInterval @default(MONTH)
  intervalCount     Int             @default(1)
  currency          String          @db.Char(3)
  amountMinor       Int
  featureSetVersion Int             @default(1)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  subscriptions GuildSubscription[]

  @@index([active, code])
}

model BillingCustomer {
  id                 String                @id @default(uuid()) @db.Uuid
  userId             String                @db.Uuid
  provider           BillingProviderName
  providerCustomerId String                @db.VarChar(255)
  emailSnapshot      String?               @db.VarChar(320)
  status             BillingCustomerStatus @default(ACTIVE)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  user          User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  subscriptions GuildSubscription[]

  @@unique([provider, providerCustomerId])
  @@unique([userId, provider])
  @@index([status])
}

model GuildSubscription {
  id                      String                  @id @default(uuid()) @db.Uuid
  guildId                 String                  @db.VarChar(20)
  purchaserUserId         String                  @db.Uuid
  billingPlanId           String                  @db.Uuid
  billingCustomerId       String?                 @db.Uuid
  planCode                String                  @db.VarChar(64)
  planDisplayNameSnapshot String                  @db.VarChar(100)
  amountMinorSnapshot     Int
  currencySnapshot        String                  @db.Char(3)
  featureSetVersion       Int
  provider                BillingProviderName
  providerCustomerId      String?                 @db.VarChar(255)
  providerSubscriptionId  String?                 @db.VarChar(255)
  providerPriceId         String?                 @db.VarChar(255)
  status                  GuildSubscriptionStatus @default(PENDING)
  cancellationStatus      CancellationStatus      @default(NONE)
  currentPeriodStart      DateTime?
  currentPeriodEnd        DateTime?
  cancelAtPeriodEnd       Boolean                 @default(false)
  cancelledAt             DateTime?
  endedAt                 DateTime?
  gracePeriodEndsAt       DateTime?
  latestPaymentStatus     PaymentStatus           @default(PENDING)
  providerStateVersion    String?                 @db.VarChar(128)
  providerUpdatedAt       DateTime?
  version                 Int                     @default(1)
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt

  guild               Guild                 @relation(fields: [guildId], references: [id], onDelete: Restrict)
  purchaser           User                  @relation("SubscriptionPurchaser", fields: [purchaserUserId], references: [id], onDelete: Restrict)
  billingPlan         BillingPlan           @relation(fields: [billingPlanId], references: [id], onDelete: Restrict)
  billingCustomer     BillingCustomer?      @relation(fields: [billingCustomerId], references: [id], onDelete: SetNull)
  entitlements        GuildEntitlement[]
  paymentTransactions PaymentTransaction[]
  checkoutSessions    CheckoutSession[]
  auditEvents         BillingAuditEvent[]
  notifications       BillingNotification[]

  @@unique([provider, providerSubscriptionId])
  @@index([guildId, status])
  @@index([purchaserUserId, status])
  @@index([provider, providerCustomerId])
  @@index([currentPeriodEnd])
  @@index([gracePeriodEndsAt])
}

model GuildEntitlement {
  id              String                 @id @default(uuid()) @db.Uuid
  guildId         String                 @db.VarChar(20)
  entitlementKey  String                 @db.VarChar(100)
  source          GuildEntitlementSource
  sourceReference String                 @db.VarChar(128)
  subscriptionId  String?                @db.Uuid
  startsAt        DateTime
  endsAt          DateTime?
  status          GuildEntitlementStatus @default(ACTIVE)
  metadata        Json                   @default("{}")
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  guild        Guild              @relation(fields: [guildId], references: [id], onDelete: Restrict)
  subscription GuildSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)

  @@unique([guildId, entitlementKey, source, sourceReference])
  @@index([guildId, status, startsAt, endsAt])
  @@index([subscriptionId, status])
  @@index([endsAt])
}

model PaymentTransaction {
  id                      String                 @id @default(uuid()) @db.Uuid
  guildId                 String                 @db.VarChar(20)
  purchaserUserId         String                 @db.Uuid
  subscriptionId          String                 @db.Uuid
  provider                BillingProviderName
  providerPaymentId       String?                @db.VarChar(255)
  providerInvoiceId       String?                @db.VarChar(255)
  merchantOrderId         String?                @db.VarChar(64)
  idempotencyKey          String                 @db.VarChar(128)
  type                    PaymentTransactionType
  status                  PaymentStatus          @default(PENDING)
  amountMinor             Int
  currency                String                 @db.Char(3)
  failureCode             String?                @db.VarChar(100)
  failureMessageSanitized String?                @db.VarChar(500)
  paidAt                  DateTime?
  refundedAt              DateTime?
  disputedAt              DateTime?
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt

  guild        Guild             @relation(fields: [guildId], references: [id], onDelete: Restrict)
  purchaser    User              @relation(fields: [purchaserUserId], references: [id], onDelete: Restrict)
  subscription GuildSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)

  @@unique([provider, idempotencyKey])
  @@unique([provider, merchantOrderId])
  @@index([provider, providerPaymentId])
  @@index([provider, providerInvoiceId])
  @@index([guildId, createdAt(sort: Desc)])
  @@index([subscriptionId, createdAt(sort: Desc)])
  @@index([status, createdAt])
}

model BillingProviderEvent {
  id                     String                     @id @default(uuid()) @db.Uuid
  provider               BillingProviderName
  providerEventId        String                     @db.VarChar(255)
  eventType              String                     @db.VarChar(128)
  environment            String                     @db.VarChar(32)
  payloadHash            String                     @db.Char(64)
  payloadSummary         Json                       @default("{}")
  signatureVerified      Boolean
  processingStatus       BillingProviderEventStatus @default(RECEIVED)
  attemptCount           Int                        @default(0)
  providerEventCreatedAt DateTime?
  receivedAt             DateTime                   @default(now())
  processedAt            DateTime?
  failureCode            String?                    @db.VarChar(100)
  lastErrorSanitized     String?                    @db.VarChar(500)
  correlationId          String                     @db.VarChar(128)

  @@unique([provider, providerEventId])
  @@index([processingStatus, receivedAt])
  @@index([provider, eventType, receivedAt(sort: Desc)])
  @@index([correlationId])
}

model CheckoutSession {
  id                  String               @id @default(uuid()) @db.Uuid
  userId              String               @db.Uuid
  guildId             String               @db.VarChar(20)
  subscriptionId      String               @db.Uuid
  provider            BillingProviderName
  planCode            String               @db.VarChar(64)
  environment         String               @db.VarChar(32)
  state               CheckoutSessionState @default(CREATED)
  nonceHash           String               @db.Char(64)
  expiresAt           DateTime
  providerSessionId   String?              @db.VarChar(255)
  amountMinorSnapshot Int
  currencySnapshot    String               @db.Char(3)
  version             Int                  @default(1)
  createdAt           DateTime             @default(now())
  completedAt         DateTime?
  updatedAt           DateTime             @updatedAt

  user         User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  guild        Guild             @relation(fields: [guildId], references: [id], onDelete: Restrict)
  subscription GuildSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)

  @@unique([provider, providerSessionId])
  @@unique([nonceHash])
  @@index([userId, createdAt(sort: Desc)])
  @@index([guildId, state])
  @@index([state, expiresAt])
}

model BillingAuditEvent {
  id             String                @id @default(uuid()) @db.Uuid
  actorType      BillingAuditActorType
  actorUserId    String?               @db.Uuid
  guildId        String?               @db.VarChar(20)
  subscriptionId String?               @db.Uuid
  action         String                @db.VarChar(128)
  previousValue  Json?
  newValue       Json?
  requestId      String                @db.VarChar(128)
  source         String                @db.VarChar(64)
  ipAddressHash  String?               @db.Char(64)
  metadata       Json                  @default("{}")
  createdAt      DateTime              @default(now())

  actor        User?              @relation("BillingAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  guild        Guild?             @relation(fields: [guildId], references: [id], onDelete: SetNull)
  subscription GuildSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([guildId, createdAt(sort: Desc)])
  @@index([subscriptionId, createdAt(sort: Desc)])
  @@index([actorUserId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@index([requestId])
}

model BillingNotification {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @db.Uuid
  guildId        String    @db.VarChar(20)
  subscriptionId String    @db.Uuid
  eventKey       String    @unique @db.VarChar(128)
  type           String    @db.VarChar(64)
  title          String    @db.VarChar(120)
  message        String    @db.VarChar(500)
  metadata       Json      @default("{}")
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  guild        Guild             @relation(fields: [guildId], references: [id], onDelete: Cascade)
  subscription GuildSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt(sort: Desc)])
  @@index([guildId, createdAt(sort: Desc)])
  @@index([subscriptionId, createdAt(sort: Desc)])
}

model BillingRiskBlock {
  id              String    @id @default(uuid()) @db.Uuid
  targetType      String    @db.VarChar(16)
  targetId        String    @db.VarChar(64)
  reason          String    @db.VarChar(500)
  status          String    @default("ACTIVE") @db.VarChar(16)
  createdByUserId String    @db.Uuid
  revokedByUserId String?   @db.Uuid
  expiresAt       DateTime?
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  createdBy User  @relation("BillingRiskBlockCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  revokedBy User? @relation("BillingRiskBlockRevokedBy", fields: [revokedByUserId], references: [id], onDelete: SetNull)

  @@index([targetType, targetId, status, expiresAt])
  @@index([createdAt(sort: Desc)])
}

model FeatureFlag {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @db.VarChar(100)
  scopeKey  String   @db.VarChar(32)
  guildId   String?  @db.VarChar(20)
  enabled   Boolean  @default(false)
  config    Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  guild Guild? @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([key, scopeKey])
  @@index([guildId, enabled])
}

model BackgroundJobRecord {
  id             String              @id @default(uuid()) @db.Uuid
  queueName      String              @db.VarChar(64)
  jobName        String              @db.VarChar(64)
  bullJobId      String?             @db.VarChar(128)
  idempotencyKey String              @db.VarChar(128)
  status         BackgroundJobStatus @default(QUEUED)
  attempts       Int                 @default(0)
  payloadHash    String              @db.Char(64)
  errorCode      String?             @db.VarChar(64)
  lastError      String?             @db.VarChar(500)
  scheduledFor   DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@unique([queueName, idempotencyKey])
  @@index([status, scheduledFor])
  @@index([queueName, createdAt(sort: Desc)])
}

model PlatformConfiguration {
  key       String   @id @db.VarChar(64)
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ModuleDefinition {
  key              String   @id @db.VarChar(64)
  enabledByDefault Boolean  @default(false)
  available        Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model LocaleDefinition {
  code      String   @id @db.VarChar(5)
  name      String   @db.VarChar(64)
  enabled   Boolean  @default(true)
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enabled])
  @@index([isDefault])
}
