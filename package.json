{
  "name": "sufbot",
  "version": "0.1.0",
  "private": true,
  "description": "Production-grade multi-tenant Discord bot and server management platform.",
  "license": "MIT",
  "author": "MRsuffix <mrsuffix>",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "preinstall": "node infrastructure/scripts/require-pnpm.mjs",
    "dev": "node infrastructure/scripts/run-with-env.mjs run dev:workspace",
    "dev:workspace": "node infrastructure/scripts/development.mjs full",
    "dev:web": "node infrastructure/scripts/run-with-env.mjs run dev:web:workspace",
    "dev:web:workspace": "node infrastructure/scripts/development.mjs web",
    "dev:api": "node infrastructure/scripts/run-with-env.mjs run dev:api:workspace",
    "dev:api:workspace": "node infrastructure/scripts/development.mjs api",
    "dev:bot": "node infrastructure/scripts/run-with-env.mjs run dev:bot:workspace",
    "dev:bot:workspace": "node infrastructure/scripts/development.mjs bot",
    "dev:worker": "node infrastructure/scripts/run-with-env.mjs run dev:worker:workspace",
    "dev:worker:workspace": "node infrastructure/scripts/development.mjs worker",
    "dev:apps": "node infrastructure/scripts/run-with-env.mjs run dev:apps:workspace",
    "dev:apps:workspace": "node infrastructure/scripts/development.mjs apps",
    "dev:packages": "node infrastructure/scripts/run-with-env.mjs run dev:packages:workspace",
    "dev:packages:workspace": "node infrastructure/scripts/development.mjs packages",
    "dev:services": "node infrastructure/scripts/run-with-env.mjs run dev:services:workspace",
    "dev:services:workspace": "docker compose up -d postgres redis",
    "dev:prepare": "node infrastructure/scripts/prepare-development.mjs",
    "clean:dev": "node infrastructure/scripts/clean-development.mjs",
    "build": "node infrastructure/scripts/run-with-env.mjs --node-env=production run build:workspace",
    "build:workspace": "pnpm --filter @sufbot/database generate && turbo run build",
    "build:packages": "node infrastructure/scripts/run-with-env.mjs run build:packages:workspace",
    "build:packages:workspace": "turbo run build --filter=./packages/*",
    "start": "node infrastructure/scripts/run-with-env.mjs --node-env=production run start:workspace",
    "start:workspace": "turbo run start --filter=./apps/* --concurrency=10",
    "format": "prettier --write .",
    "format:check": "node infrastructure/scripts/run-with-env.mjs exec prettier --check .",
    "lint": "node infrastructure/scripts/run-with-env.mjs exec eslint . --max-warnings=0",
    "typecheck": "node infrastructure/scripts/run-with-env.mjs run typecheck:workspace",
    "typecheck:workspace": "pnpm --filter @sufbot/database generate && turbo run typecheck && tsc -p tsconfig.tools.json --noEmit",
    "test": "node infrastructure/scripts/run-with-env.mjs run test:workspace",
    "test:workspace": "pnpm --filter @sufbot/database generate && pnpm build:packages:workspace && vitest run",
    "test:watch": "node infrastructure/scripts/run-with-env.mjs exec vitest",
    "test:coverage": "node infrastructure/scripts/run-with-env.mjs run test:coverage:workspace",
    "test:coverage:workspace": "pnpm --filter @sufbot/database generate && pnpm build:packages:workspace && vitest run --coverage",
    "test:e2e": "node infrastructure/scripts/run-with-env.mjs exec playwright test",
    "db:generate": "node infrastructure/scripts/run-with-env.mjs --filter @sufbot/database generate",
    "db:validate": "node infrastructure/scripts/run-with-env.mjs --filter @sufbot/database validate",
    "db:migrate": "node infrastructure/scripts/run-with-env.mjs --filter @sufbot/database migrate",
    "db:deploy": "node infrastructure/scripts/run-with-env.mjs --filter @sufbot/database migrate:deploy",
    "db:seed": "node infrastructure/scripts/run-with-env.mjs --filter @sufbot/database seed",
    "db:studio": "node infrastructure/scripts/run-with-env.mjs --filter @sufbot/database studio",
    "db:reset": "node infrastructure/scripts/run-with-env.mjs --filter @sufbot/database migrate:reset",
    "env:check": "tsx infrastructure/scripts/env-check.ts",
    "env:configure-local": "node infrastructure/scripts/configure-local-services.mjs",
    "services:check": "tsx infrastructure/scripts/services-check.ts",
    "worker:check": "tsx infrastructure/scripts/worker-check.ts",
    "commands:validate": "tsx infrastructure/scripts/commands.ts validate",
    "commands:list": "tsx infrastructure/scripts/commands.ts list",
    "commands:deploy:guild": "node infrastructure/scripts/run-with-env.mjs exec tsx infrastructure/scripts/commands.ts deploy:guild",
    "commands:deploy:global": "node infrastructure/scripts/run-with-env.mjs --node-env=production exec tsx infrastructure/scripts/commands.ts deploy:global",
    "commands:clear:guild": "node infrastructure/scripts/run-with-env.mjs exec tsx infrastructure/scripts/commands.ts clear:guild",
    "commands:status": "node infrastructure/scripts/run-with-env.mjs exec tsx infrastructure/scripts/commands.ts status",
    "check:web": "node infrastructure/scripts/run-with-env.mjs exec tsx infrastructure/scripts/check-web.ts",
    "check:api": "node infrastructure/scripts/run-with-env.mjs exec tsx infrastructure/scripts/check-api.ts",
    "check:dev": "node infrastructure/scripts/run-with-env.mjs exec tsx infrastructure/scripts/check-development.ts",
    "docker:up": "docker compose up -d postgres redis",
    "docker:down": "docker compose down",
    "docker:reset": "node infrastructure/scripts/docker-reset.mjs",
    "docker:config": "docker compose config --quiet",
    "security:audit": "pnpm audit --audit-level high"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.62.0",
    "@prisma/config": "7.9.0",
    "@sufbot/auth": "workspace:*",
    "@sufbot/billing": "workspace:*",
    "@sufbot/cache": "workspace:*",
    "@sufbot/config": "workspace:*",
    "@sufbot/database": "workspace:*",
    "@sufbot/discord": "workspace:*",
    "@sufbot/eslint-config": "workspace:*",
    "@sufbot/logger": "workspace:*",
    "@sufbot/permissions": "workspace:*",
    "@sufbot/queue": "workspace:*",
    "@sufbot/shared": "workspace:*",
    "@sufbot/typescript-config": "workspace:*",
    "@types/node": "24.13.3",
    "@types/pg": "8.20.0",
    "@vitest/coverage-v8": "4.1.10",
    "discord.js": "14.27.0",
    "dotenv": "17.4.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.11",
    "globals": "16.5.0",
    "ioredis": "5.11.1",
    "pg": "8.22.0",
    "prettier": "3.9.6",
    "turbo": "2.10.6",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10",
    "zod": "4.4.3"
  }
}
