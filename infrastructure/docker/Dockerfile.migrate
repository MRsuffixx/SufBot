FROM node:24.13.0-alpine AS build

ENV CI=true
WORKDIR /workspace

RUN corepack enable && corepack prepare pnpm@11.9.0 --activate

COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @sufbot/migrator deploy --prod /output
RUN cp packages/database/prisma.config.ts /output/prisma.config.ts \
    && cp packages/database/environment.ts /output/environment.ts \
    && cp -r packages/database/prisma /output/prisma

FROM node:24.13.0-alpine

ENV NODE_ENV=production
WORKDIR /app

RUN apk add --no-cache tini \
    && chown node:node /app

COPY --from=build --chown=node:node /output ./

USER node
ENTRYPOINT ["/sbin/tini", "--"]
CMD ["./node_modules/.bin/prisma", "migrate", "deploy", "--config", "prisma.config.ts"]
