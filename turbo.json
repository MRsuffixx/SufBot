{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalDependencies": ["config.json", "config.*.json", ".env", ".env.*", "tsconfig.json"],
  "globalEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "DIRECT_DATABASE_URL",
    "REDIS_URL",
    "DISCORD_BOT_TOKEN",
    "DISCORD_APPLICATION_ID",
    "DISCORD_CLIENT_ID",
    "DISCORD_CLIENT_SECRET",
    "DISCORD_PUBLIC_KEY",
    "DISCORD_DEVELOPMENT_GUILD_IDS",
    "AUTH_SECRET",
    "AUTH_TRUST_HOST",
    "INTERNAL_API_SECRET",
    "WEBHOOK_SIGNING_SECRET",
    "ENCRYPTION_KEY",
    "SESSION_ENCRYPTION_KEY",
    "BOT_OWNER_DISCORD_IDS",
    "BOT_DEVELOPER_DISCORD_IDS",
    "PLATFORM_ADMIN_DISCORD_IDS",
    "SENTRY_DSN"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "../../config.json"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "dev:build": {
      "dependsOn": ["^dev:build"],
      "inputs": ["$TURBO_DEFAULT$", "../../config.json"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "interruptible": true
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "start": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    }
  }
}
